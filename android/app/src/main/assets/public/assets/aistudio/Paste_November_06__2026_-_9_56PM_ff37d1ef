<script>
/* ================= DATABASE & STATE ================= */
let balance = 15683.01;
let isBalanceMasked = false;
let typedLoginPin = "";
let enteredTxPin = "";
let currentTxFilter = "all";

const registeredAccounts = [
  { name: "Tsegaye Abebe Berihun", acc: "1000293817314", masked: "1*********7314", initials: "TA" },
  { name: "Sofiya Seid Yesuf", acc: "1000392819143", masked: "1*********9143", initials: "SS" },
  { name: "Abdu Mohammed", acc: "1000592813321", masked: "1*********3321", initials: "AM" },
  { name: "Aminat Mohammed", acc: "1000782910012", masked: "1*********0012", initials: "AM" },
  { name: "Bilal Seid Abdu", acc: "1000382106157", masked: "1*********6157", initials: "BA" },
  { name: "Momina Mekuriyaw Adem", acc: "1000482914708", masked: "1*********4708", initials: "MM" },
  { name: "Sara Endris Ali", acc: "1000293813474", masked: "1*********3474", initials: "SE" },
  { name: "Fuad Aragaw Hassen", acc: "1000192815952", masked: "1*********5952", initials: "FA" }
];

let activeRecipient = registeredAccounts[0];

/* Exactly matching the transactions from your photo */
let transactionHistory = [
  { name: "Sofiya Seid", date: "05-Nov-26 12:44 PM", amount: 5000.00, type: "credited", cat: "ACCOUNT TO ACCOUNT" },
  { name: "Tsegaye Abebe", date: "05-Nov-26 12:12 PM", amount: 850.00, type: "debited", cat: "ACCOUNT TO ACCOUNT" },
  { name: "Abdu Mohammed", date: "05-Nov-26 11:14 AM", amount: 500.00, type: "debited", cat: "ACCOUNT TO ACCOUNT" },
  { name: "Air Time", date: "04-Nov-26 8:40 PM", amount: 45.00, type: "debited", cat: "TOP-UP (AIRTIME & DATA RECHARGE)" },
  { name: "Aminat Mohammed", date: "04-Nov-26 7:39 PM", amount: 2000.00, type: "credited", cat: "ACCOUNT TO ACCOUNT" },
  { name: "Bilal Seid", date: "04-Nov-26 3:20 PM", amount: 400.00, type: "debited", cat: "ACCOUNT TO ACCOUNT" }
];

function notify(text) {
  const toast = document.getElementById('toast-box');
  toast.textContent = text;
  toast.classList.add('show');
  setTimeout(() => toast.classList.remove('show'), 1800);
}

function goToScreen(screenId) {
  document.querySelectorAll('.screen').forEach(s => s.classList.remove('active'));
  document.getElementById(screenId).classList.add('active');
}

function openHomeScreen() {
  document.querySelectorAll('.nav-tab-btn').forEach(b => b.classList.remove('active'));
  document.querySelectorAll('#btn-nav-home').forEach(b => b.classList.add('active'));
  goToScreen('screen-home');
}

function openTransactionsScreen() {
  document.querySelectorAll('.nav-tab-btn').forEach(b => b.classList.remove('active'));
  document.querySelectorAll('#btn-nav-tx').forEach(b => b.classList.add('active'));
  renderTransactions();
  goToScreen('screen-transactions');
}

function copyAcc() {
  navigator.clipboard?.writeText('1000562339427');
  notify('Copied: 1000562339427');
}

function toggleLanguage() {
  const isEng = document.querySelector('.active-lang-txt').textContent === 'English';
  const newLang = isEng ? 'አማርኛ' : 'English';
  document.querySelectorAll('.active-lang-txt, .lang-chip').forEach(el => el.textContent = newLang + ' ▾');
  notify('Language changed: ' + newLang);
}

function toggleBalanceMask() {
  isBalanceMasked = !isBalanceMasked;
  const val = isBalanceMasked ? "******" : balance.toLocaleString('en-US', { minimumFractionDigits: 2 });
  document.querySelectorAll('.app-amount-txt').forEach(el => el.textContent = val);
}

/* Login */
function focusPinInput() {
  if (typedLoginPin.length < 4) {
    typedLoginPin = "1234";
    document.getElementById('login-pin-txt').textContent = "••••";
    document.getElementById('login-pin-txt').classList.add('filled');
  }
}
function quickBiometricLogin() {
  notify('Biometric verified');
  setTimeout(openHomeScreen, 250);
}
function submitLogin() {
  openHomeScreen();
}

/* Transactions Filter & Render */
function setTxFilter(filter, tabEl) {
  currentTxFilter = filter;
  document.querySelectorAll('.tx-tab').forEach(t => t.classList.remove('active'));
  tabEl.classList.add('active');
  renderTransactions();
}

function renderTransactions() {
  const container = document.getElementById('tx-history-container');
  container.innerHTML = "";

  const filtered = transactionHistory.filter(item => {
    if (currentTxFilter === 'all') return true;
    return item.type === currentTxFilter;
  });

  filtered.forEach(tx => {
    const card = document.createElement('div');
    card.className = "tx-card";

    const isCredit = tx.type === "credited";
    const sign = isCredit ? "+" : "-";
    const arrowSvg = isCredit
      ? `<svg viewBox="0 0 24 24" fill="currentColor" style="width:18px;height:18px;"><path d="M19 13h-6v6h-2v-6H5v-2h6V5h2v6h6v2z" transform="rotate(45 12 12)"/></svg>`
      : `<svg viewBox="0 0 24 24" fill="currentColor" style="width:18px;height:18px;"><path d="M5 4v2h10.59L3.29 18.29l1.42 1.42L17 7.41V18h2V4z"/></svg>`;

    card.innerHTML = `
      <div class="tx-left">
        <div class="tx-arrow-icon ${tx.type}">
          ${arrowSvg}
        </div>
        <div>
          <div class="tx-title">${tx.name}</div>
          <div class="tx-date">${tx.date}</div>
        </div>
      </div>
      <div class="tx-right">
        <div class="tx-amount ${tx.type}">
          ${sign}${tx.amount.toLocaleString('en-US', { minimumFractionDigits: 2 })} ETB
        </div>
        <div class="tx-category">${tx.cat}</div>
      </div>
    `;
    container.appendChild(card);
  });
}

/* Transfer Autocomplete */
const accInput = document.getElementById('transfer-acc-input');
const dropdown = document.getElementById('search-dropdown-menu');
const receiverBanner = document.getElementById('receiver-banner');
const receiverText = document.getElementById('resolved-receiver-text');

function handleAccountSearch() {
  const query = accInput.value.trim().toLowerCase();
  
  if (!query) {
    dropdown.classList.remove('open');
    return;
  }

  const results = registeredAccounts.filter(a => 
    a.acc.includes(query) || a.name.toLowerCase().includes(query)
  );

  if (results.length === 0) {
    dropdown.classList.remove('open');
    return;
  }

  dropdown.innerHTML = "";
  results.forEach(item => {
    const row = document.createElement('div');
    row.className = "search-item";
    row.innerHTML = `
      <div class="search-item-name">${item.name}</div>
      <div class="search-item-acc">${item.acc}</div>
    `;
    row.onclick = () => chooseRecipient(item);
    dropdown.appendChild(row);
  });

  dropdown.classList.add('open');

  const exact = registeredAccounts.find(a => a.acc === query);
  if (exact) chooseRecipient(exact);
}

function chooseRecipient(item) {
  activeRecipient = item;
  accInput.value = item.acc;
  receiverText.textContent = item.name;
  receiverBanner.classList.add('show');
  dropdown.classList.remove('open');
}

function renderTransferList() {
  const list = document.getElementById('transfer-recent-list');
  list.innerHTML = "";
  registeredAccounts.forEach(c => {
    const row = document.createElement('div');
    row.className = "recent-beneficiary-item";
    row.onclick = () => chooseRecipient(c);
    row.innerHTML = `
      <div style="display:flex;align-items:center;gap:12px;">
        <div class="recent-avatar">${c.initials}</div>
        <div>
          <div style="font-size:13px;font-weight:700;color:#222;">${c.name}</div>
          <div style="font-size:11px;color:#888;">${c.masked}</div>
        </div>
      </div>
      <div style="display:flex;align-items:center;gap:12px;color:#bbb;">
        <svg style="width:16px;height:16px;" viewBox="0 0 24 24" fill="currentColor"><path d="M6 19c0 1.1.9 2 2 2h8c1.1 0 2-.9 2-2V7H6v12zM19 4h-3.5l-1-1h-5l-1 1H5v2h14V4z"/></svg>
        <svg style="width:16px;height:16px;" viewBox="0 0 24 24" fill="currentColor"><path d="M8.59 16.59L13.17 12 8.59 7.41 10 6l6 6-6 6-1.41-1.41z"/></svg>
      </div>
    `;
    list.appendChild(row);
  });
}

/* Modals */
function openConfirmDialog() {
  const amt = parseFloat(document.getElementById('transfer-amount-input').value);
  if (!amt || amt <= 0) return notify('Please enter a valid amount');

  document.getElementById('confirm-receiver-name').textContent = activeRecipient.name;
  document.getElementById('confirm-receiver-acc').textContent = activeRecipient.acc;
  document.getElementById('confirm-amount-val').textContent = amt.toFixed(2) + " ETB";
  document.getElementById('confirm-modal').classList.add('show');
}
function closeConfirmDialog() {
  document.getElementById('confirm-modal').classList.remove('show');
}
function openPinDialog() {
  closeConfirmDialog();
  enteredTxPin = "";
  updatePinDots();
  document.getElementById('pin-modal').classList.add('show');
}
function closePinDialog() {
  document.getElementById('pin-modal').classList.remove('show');
}
function pressTxPin(digit) {
  if (enteredTxPin.length < 6) {
    enteredTxPin += digit;
    updatePinDots();
  }
  if (enteredTxPin.length === 6) {
    setTimeout(executeTransfer, 250);
  }
}
function delTxPin() {
  enteredTxPin = enteredTxPin.slice(0, -1);
  updatePinDots();
}
function updatePinDots() {
  for (let i = 1; i <= 6; i++) {
    const el = document.getElementById(`p-${i}`);
    if (i <= enteredTxPin.length) el.classList.add('filled');
    else el.classList.remove('filled');
  }
}

/* Transaction Execution & Receipt */
function executeTransfer() {
  closePinDialog();
  const amt = parseFloat(document.getElementById('transfer-amount-input').value) || 850.00;
  balance -= amt;
  
  document.querySelectorAll('.app-amount-txt').forEach(el => {
    el.textContent = balance.toLocaleString('en-US', { minimumFractionDigits: 2 });
  });

  const now = new Date();
  const months = ["Jan", "Feb", "Mar", "Apr", "May", "Jun", "Jul", "Aug", "Sep", "Oct", "Nov", "Dec"];
  const dateFormatted = `${String(now.getDate()).padStart(2, '0')}-${months[now.getMonth()]}-${String(now.getFullYear()).slice(-2)} ${now.toLocaleTimeString([], {hour: '2-digit', minute:'2-digit'})}`;
  
  // Prepend to transaction list
  transactionHistory.unshift({
    name: activeRecipient.name,
    date: dateFormatted,
    amount: amt,
    type: "debited",
    cat: "ACCOUNT TO ACCOUNT"
  });

  const fullDateStr = `${String(now.getDate()).padStart(2, '0')} ${months[now.getMonth()]} ${now.getFullYear()} ${now.toLocaleTimeString([], {hour: '2-digit', minute:'2-digit'})}`;
  const randomTx = "FT" + Math.floor(1000000000 + Math.random() * 9000000000).toString().substring(0, 10);
  const shortAcc = "ETB-" + activeRecipient.acc.slice(-4);

  document.getElementById('rcpt-sum-amt').textContent = amt.toFixed(2);
  document.getElementById('rcpt-sum-receiver').textContent = activeRecipient.name;
  document.getElementById('rcpt-sum-acc').textContent = shortAcc;
  document.getElementById('rcpt-sum-date').textContent = fullDateStr;
  document.getElementById('rcpt-sum-txid').textContent = randomTx;
  document.getElementById('rcpt-sum-debited').textContent = amt.toFixed(2);
  document.getElementById('rcpt-sum-qr').src = `https://api.qrserver.com/v1/create-qr-code/?size=180x180&data=${randomTx}-${amt}ETB-CBE`;

  goToScreen('screen-receipt');
}

// Initialize
renderTransferList();
renderTransactions();
chooseRecipient(registeredAccounts[0]);
</script>
