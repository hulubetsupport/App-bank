<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover">
<meta name="theme-color" content="#7C21A4">
<title>Commercial Bank of Ethiopia</title>
<style>
:root {
  --purple: #7C21A4;
  --purple-dark: #631684;
  --gold: #b58d4e;
  --gold-light: #dfba6c;
  --card-bg: #181818;
  --page-bg: #F5F3EC;
  --tile-bg: #EAE6DB;
  --ink: #2b2b2b;
  --muted: #8c8998;
}
* {
  box-sizing: border-box;
  margin: 0;
  padding: 0;
  font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, Helvetica, Arial, sans-serif;
  -webkit-tap-highlight-color: transparent;
  user-select: none;
}
body {
  background: #111;
  display: flex;
  justify-content: center;
  align-items: center;
  min-height: 100vh;
  min-height: 100dvh;
  color: var(--ink);
}
button {
  font: inherit;
  border: 0;
  cursor: pointer;
}

/* Device Shell Formatted To Exactly Match User Phone Frame */
.app {
  width: min(100%, 412px);
  height: 860px;
  background: var(--page-bg);
  position: relative;
  overflow: hidden;
  border-radius: 36px;
  box-shadow: 0 20px 50px rgba(0, 0, 0, 0.55);
  display: flex;
  flex-direction: column;
}

/* Screens */
.screen {
  position: absolute;
  inset: 0;
  display: none;
  flex-direction: column;
  background: var(--page-bg);
  z-index: 10;
}
.screen.active {
  display: flex;
}

.icon {
  display: inline-flex;
  align-items: center;
  justify-content: center;
}
.icon svg {
  width: 100%;
  height: 100%;
  display: block;
}

/* ================= 1. LOGIN SCREEN ================= */
#screen-login {
  background: #ffffff;
  padding: 24px 22px;
  justify-content: space-between;
  align-items: center;
}
.login-top-bar {
  width: 100%;
  display: flex;
  justify-content: space-between;
  align-items: center;
}
.circle-btn {
  width: 42px;
  height: 42px;
  border-radius: 50%;
  background: #f7f6f2;
  display: grid;
  place-items: center;
  color: #333;
}
.circle-btn svg {
  width: 20px;
  height: 20px;
  stroke: currentColor;
  fill: none;
  stroke-width: 1.8;
}
.lang-pill {
  padding: 8px 18px;
  border-radius: 20px;
  background: #fff;
  border: 1px solid #eee;
  font-size: 13px;
  font-weight: 500;
  color: #333;
  display: flex;
  align-items: center;
  gap: 4px;
  box-shadow: 0 2px 6px rgba(0,0,0,0.03);
}

.login-center {
  display: flex;
  flex-direction: column;
  align-items: center;
  text-align: center;
  width: 100%;
}
.cbe-gold-logo {
  width: 110px;
  height: 110px;
  object-fit: contain;
  margin-bottom: 12px;
}
.cbe-amh {
  font-size: 19px;
  font-weight: 700;
  color: #b58d4e;
  letter-spacing: 0.5px;
}
.cbe-eng {
  font-size: 11px;
  font-weight: 700;
  letter-spacing: 1px;
  color: #444;
  margin-top: 4px;
}
.login-welcome {
  margin-top: 32px;
  font-size: 15px;
  color: #777;
}

.login-pin-card {
  width: 100%;
  height: 56px;
  background: #fff;
  border-radius: 16px;
  margin-top: 18px;
  display: flex;
  align-items: center;
  padding: 0 18px;
  gap: 14px;
  box-shadow: 0 4px 18px rgba(0,0,0,0.06);
  border: 1px solid #f0ede6;
}
.pin-display-text {
  font-size: 16px;
  color: #999;
  letter-spacing: 2px;
  font-weight: 600;
}
.pin-display-text.filled {
  color: var(--purple);
  font-size: 26px;
  letter-spacing: 8px;
}

.bio-wrap {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 8px;
  margin-top: 32px;
  cursor: pointer;
}
.bio-circle {
  width: 60px;
  height: 60px;
  border-radius: 50%;
  background: var(--purple);
  display: grid;
  place-items: center;
  color: #fff;
  box-shadow: 0 6px 18px rgba(124, 33, 164, 0.35);
}
.bio-label {
  font-size: 10.5px;
  font-weight: 700;
  letter-spacing: 1px;
  color: #333;
}

.gold-login-btn {
  width: 100%;
  height: 52px;
  border-radius: 26px;
  background: var(--gold);
  color: #fff;
  font-size: 16px;
  font-weight: 600;
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 8px;
  box-shadow: 0 6px 16px rgba(181, 141, 78, 0.3);
}
.copyright-text {
  font-size: 11px;
  color: #aaa;
  text-align: center;
  margin-top: 14px;
}

/* ================= 2. PURPLE HEADER (SHARED) ================= */
.purple-header {
  background: var(--purple);
  padding: 16px 18px 12px;
  color: #fff;
  position: relative;
  flex-shrink: 0;
}
.header-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
}
.user-greeting {
  display: flex;
  align-items: center;
  gap: 10px;
}
.app-grid-icon {
  width: 32px;
  height: 32px;
  border-radius: 50%;
  background: rgba(255,255,255,0.18);
  display: grid;
  place-items: center;
}
.user-name-title {
  font-size: 10px;
  color: rgba(255,255,255,0.8);
}
.user-name-bold {
  font-size: 15px;
  font-weight: 700;
}
.header-right-btns {
  display: flex;
  align-items: center;
  gap: 10px;
}
.lang-chip {
  background: rgba(255,255,255,0.2);
  color: #fff;
  padding: 5px 12px;
  border-radius: 16px;
  font-size: 12px;
  font-weight: 500;
  cursor: pointer;
}
.round-icon-btn {
  width: 34px;
  height: 34px;
  border-radius: 50%;
  background: rgba(255,255,255,0.18);
  display: grid;
  place-items: center;
  color: #fff;
}
.round-icon-btn svg {
  width: 17px;
  height: 17px;
  stroke: currentColor;
  fill: none;
  stroke-width: 2;
}

/* ================= BLACK #181818 BANK CARD ================= */
.card-wrapper {
  padding: 0 16px;
  margin-top: 4px;
  position: relative;
  z-index: 5;
  flex-shrink: 0;
}
.balance-card {
  background: var(--card-bg) url('https://i.postimg.cc/tJHVbGWH/20261105-173340.png') center/cover no-repeat;
  border-radius: 22px;
  padding: 18px 20px 14px;
  color: var(--gold-light);
  box-shadow: 0 12px 28px rgba(0,0,0,0.35);
  border: 1px solid rgba(255, 255, 255, 0.08);
  position: relative;
}
.card-header-flex {
  display: flex;
  align-items: center;
  gap: 12px;
}
.card-coin {
  width: 40px;
  height: 40px;
  object-fit: contain;
  flex-shrink: 0;
}
.card-cbe-name {
  font-size: 13.5px;
  font-weight: 700;
  color: #dfba6c;
  letter-spacing: 0.3px;
}
.card-slogan {
  font-size: 10px;
  color: #baa069;
  margin-top: 2px;
}
.card-balance-row {
  margin: 18px 0 14px;
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 8px;
  font-size: 27px;
  letter-spacing: 2px;
  font-weight: 700;
  color: #fff;
  position: relative;
}
.card-balance-row em {
  font-size: 13px;
  font-style: normal;
  letter-spacing: 0;
  font-weight: 600;
  color: #dfba6c;
}
.eye-toggle-btn {
  position: absolute;
  right: 0;
  top: 50%;
  transform: translateY(-50%);
  color: #8c979a;
  background: none;
}
.eye-toggle-btn svg {
  width: 21px;
  height: 21px;
  stroke: currentColor;
  fill: none;
  stroke-width: 1.8;
}
.card-account-row {
  margin-top: 18px;
  text-align: center;
  font-size: 12px;
  letter-spacing: 1px;
  color: #d1c8a5;
}
.card-account-row button {
  background: none;
  color: #bbb;
  vertical-align: middle;
  margin-left: 6px;
}
.card-account-row button svg {
  width: 16px;
  height: 16px;
  stroke: currentColor;
  fill: none;
  stroke-width: 1.8;
}
.card-date-row {
  text-align: center;
  font-size: 10px;
  color: #7a8486;
  margin-top: 8px;
}

/* ================= HOME DASHBOARD BODY ================= */
.home-scroll-area {
  flex: 1;
  background: var(--page-bg);
  border-radius: 28px 28px 0 0;
  margin-top: 8px;
  padding: 12px 16px 80px;
  overflow-y: auto;
}
.home-scroll-area::-webkit-scrollbar { display: none; }
.handle-bar {
  width: 36px;
  height: 4px;
  border-radius: 8px;
  background: #d9c8b4;
  margin: 0 auto 12px;
}

/* 4 Circular Action Icons */
.quick-row {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin: 4px 0 16px;
  padding: 0 4px;
}
.quick-action-item {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 6px;
  font-size: 11px;
  font-weight: 600;
  color: #4b4b4b;
  text-align: center;
  width: 68px;
}
.quick-icon-circle {
  width: 48px;
  height: 48px;
  border-radius: 50%;
  background: #fff;
  box-shadow: 0 3px 10px rgba(0,0,0,0.05);
  display: grid;
  place-items: center;
  color: var(--purple);
}
.quick-icon-circle svg {
  width: 22px;
  height: 22px;
  stroke: currentColor;
  fill: none;
  stroke-width: 1.9;
}
.quick-arrow-right {
  width: 22px;
  height: 22px;
  border-radius: 50%;
  background: #fff;
  box-shadow: 0 2px 6px rgba(0,0,0,0.08);
  display: grid;
  place-items: center;
  color: #888;
  font-size: 14px;
}

/* 8 CBE Grid Cards */
.tiles-grid {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 10px;
}
.service-tile {
  background: var(--tile-bg);
  border-radius: 18px;
  padding: 14px 12px;
  box-shadow: 0 2px 8px rgba(0,0,0,0.02);
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  text-align: center;
  gap: 5px;
  min-height: 86px;
}
.tile-avatar-icon {
  width: 28px;
  height: 28px;
  display: grid;
  place-items: center;
}
.tile-avatar-icon.red { color: #d63031; }
.tile-avatar-icon.green { color: #2e7d32; }
.tile-avatar-icon.purple { color: var(--purple); }
.service-tile strong {
  font-size: 13px;
  font-weight: 600;
  color: #2b2b2b;
}
.service-tile small {
  font-size: 10px;
  color: #777;
}

/* Floating Scan QR Pill */
.scan-qr-float {
  position: absolute;
  bottom: 66px;
  left: 50%;
  transform: translateX(-50%);
  background: var(--purple);
  color: #fff;
  padding: 8px 20px;
  border-radius: 24px;
  font-size: 13.5px;
  font-weight: 700;
  display: flex;
  align-items: center;
  gap: 8px;
  box-shadow: 0 6px 18px rgba(124, 33, 164, 0.4);
  z-index: 20;
}
.scan-qr-float svg {
  width: 17px;
  height: 17px;
  stroke: currentColor;
  fill: none;
  stroke-width: 2;
}

/* Bottom Nav */
.bottom-nav {
  position: absolute;
  bottom: 0;
  left: 0;
  width: 100%;
  height: 60px;
  background: var(--page-bg);
  border-top: 1px solid #e2ded3;
  display: flex;
  justify-content: space-around;
  align-items: center;
  z-index: 15;
}
.nav-tab-btn {
  background: none;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 3px;
  color: #777;
  font-size: 11px;
  font-weight: 600;
  position: relative;
  min-width: 65px;
}
.nav-tab-btn svg {
  width: 22px;
  height: 22px;
  stroke: currentColor;
  fill: none;
  stroke-width: 1.8;
}
.nav-tab-btn.active {
  color: var(--purple);
}
.nav-tab-btn.active .nav-icon-pill {
  background: #e9dec9;
  padding: 2px 14px;
  border-radius: 14px;
  display: flex;
  align-items: center;
  justify-content: center;
}
.nav-tab-btn.active svg {
  stroke: var(--purple);
}

/* ================= 3. TRANSACTIONS SCREEN ================= */
#screen-transactions {
  overflow: hidden;
}
.tx-scroll-area {
  flex: 1;
  background: var(--page-bg);
  border-radius: 28px 28px 0 0;
  margin-top: 8px;
  padding: 14px 16px 75px;
  overflow-y: auto;
}
.tx-scroll-area::-webkit-scrollbar { display: none; }
.tx-filter-bar {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 12px;
  border-bottom: 1px solid #ded9cc;
  padding-bottom: 8px;
}
.tx-filters {
  display: flex;
  gap: 22px;
  font-size: 13px;
  font-weight: 600;
}
.tx-tab {
  color: #8c8896;
  position: relative;
  cursor: pointer;
  padding-bottom: 6px;
}
.tx-tab.active {
  color: #2b2b2b;
}
.tx-tab.active:after {
  content: "";
  position: absolute;
  bottom: -8px;
  left: 0;
  right: 0;
  height: 2.5px;
  background: var(--purple);
  border-radius: 2px;
}
.tx-search-btn {
  color: #777;
  cursor: pointer;
}
.tx-list {
  display: flex;
  flex-direction: column;
  gap: 8px;
}
.tx-card {
  background: #fff;
  border-radius: 16px;
  padding: 12px 14px;
  display: flex;
  align-items: center;
  justify-content: space-between;
  box-shadow: 0 2px 8px rgba(0,0,0,0.03);
}
.tx-left {
  display: flex;
  align-items: center;
  gap: 12px;
}
.tx-arrow-icon {
  width: 34px;
  height: 34px;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
}
.tx-arrow-icon.debited {
  background: #fdebed;
  color: #d63031;
}
.tx-arrow-icon.credited {
  background: #e8f5e9;
  color: #2e7d32;
}
.tx-title {
  font-size: 13px;
  font-weight: 600;
  color: #2b2b2b;
}
.tx-date {
  font-size: 11px;
  color: #888;
  margin-top: 3px;
}
.tx-right {
  text-align: right;
}
.tx-amount {
  font-size: 13.5px;
  font-weight: 700;
}
.tx-amount.debited { color: #d63031; }
.tx-amount.credited { color: #2e7d32; }
.tx-category {
  font-size: 9.5px;
  color: #8c8896;
  text-transform: uppercase;
  margin-top: 4px;
  letter-spacing: 0.3px;
}

/* ================= 4. TRANSFER SCREEN ================= */
#screen-transfer {
  background: var(--page-bg);
}
.transfer-nav-bar {
  background: var(--purple);
  padding: 16px 18px 12px;
  display: flex;
  align-items: center;
  gap: 14px;
  color: #fff;
  font-size: 17px;
  font-weight: 700;
}
.back-circle-btn {
  width: 32px;
  height: 32px;
  border-radius: 50%;
  background: rgba(255,255,255,0.22);
  display: grid;
  place-items: center;
  color: #fff;
}
.back-circle-btn svg {
  width: 16px;
  height: 16px;
  stroke: currentColor;
  fill: none;
  stroke-width: 2.4;
}
.transfer-card-sheet {
  flex: 1;
  background: #fff;
  border-radius: 28px 28px 0 0;
  margin-top: -6px;
  padding: 16px 18px;
  overflow-y: auto;
}
.transfer-card-sheet::-webkit-scrollbar { display: none; }

.acc-switch-row {
  display: flex;
  gap: 10px;
  margin-bottom: 12px;
}
.acc-toggle-pill {
  flex: 1;
  height: 40px;
  border-radius: 20px;
  font-size: 13px;
  font-weight: 600;
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 6px;
}
.acc-toggle-pill.active {
  background: var(--purple);
  color: #fff;
}
.acc-toggle-pill.inactive {
  background: #fff;
  border: 1px solid #e5e0d4;
  color: #666;
}

.from-account-box {
  background: #1c2833;
  border-radius: 16px;
  padding: 14px 16px;
  color: #fff;
  margin-bottom: 12px;
  display: flex;
  justify-content: space-between;
  align-items: center;
}
.from-acc-title {
  font-size: 11px;
  color: #9cb1c4;
}
.from-acc-num {
  font-size: 13.5px;
  font-weight: 600;
  margin-top: 4px;
}
.from-acc-balance {
  font-size: 11px;
  color: #aaa;
  margin-top: 4px;
  display: flex;
  align-items: center;
  gap: 6px;
}
.change-link {
  color: #dfba6c;
  font-size: 12px;
  font-weight: 700;
  display: flex;
  flex-direction: column;
  align-items: flex-end;
  gap: 2px;
}

.receiver-resolved-banner {
  background: #f7ecfa;
  border: 1px solid #e1bde9;
  border-radius: 12px;
  padding: 10px 14px;
  margin-bottom: 10px;
  display: none;
  align-items: center;
  justify-content: space-between;
}
.receiver-resolved-banner.show {
  display: flex;
}
.receiver-resolved-name {
  font-size: 13px;
  font-weight: 700;
  color: var(--purple);
}
.receiver-verified-badge {
  font-size: 10.5px;
  color: #2e7d32;
  font-weight: 700;
}

.tx-input-card {
  position: relative;
  background: #fff;
  border-radius: 14px;
  border: 1px solid #e8e3d8;
  height: 50px;
  display: flex;
  align-items: center;
  padding: 0 14px;
  gap: 12px;
  margin-bottom: 10px;
}
.tx-input-card input {
  border: none;
  outline: none;
  width: 100%;
  font-size: 14px;
  color: #222;
}
.input-side-icon {
  width: 20px;
  height: 20px;
  color: var(--purple);
  flex-shrink: 0;
}

.search-dropdown {
  position: absolute;
  top: 54px;
  left: 0;
  right: 0;
  background: #fff;
  border-radius: 14px;
  box-shadow: 0 10px 25px rgba(0,0,0,0.15);
  border: 1px solid #e0d9cb;
  max-height: 200px;
  overflow-y: auto;
  z-index: 50;
  display: none;
}
.search-dropdown.open { display: block; }
.search-item {
  padding: 10px 14px;
  border-bottom: 1px solid #f2eee6;
  cursor: pointer;
}
.search-item:hover { background: #fbf7ef; }
.search-item-name {
  font-size: 13px;
  font-weight: 700;
  color: #333;
}
.search-item-acc {
  font-size: 11px;
  color: #888;
}

.add-remark-row {
  display: flex;
  align-items: center;
  gap: 8px;
  font-size: 12px;
  color: #666;
  margin: 6px 0 16px;
  cursor: pointer;
}
.add-remark-row svg {
  width: 18px;
  height: 18px;
  color: var(--purple);
}

.purple-continue-btn {
  width: 100%;
  height: 48px;
  background: var(--purple);
  color: #fff;
  border-radius: 24px;
  font-size: 15px;
  font-weight: 700;
  box-shadow: 0 6px 18px rgba(124, 33, 164, 0.35);
  margin-bottom: 16px;
}

.tx-tabs-line {
  display: flex;
  gap: 24px;
  border-bottom: 1px solid #ded9cc;
  padding-bottom: 8px;
  font-size: 13px;
  font-weight: 700;
}
.tab-under {
  color: #888;
  cursor: pointer;
}
.tab-under.active {
  color: var(--purple);
  border-bottom: 2px solid var(--purple);
  padding-bottom: 6px;
}

.recent-beneficiary-item {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 11px 0;
  border-bottom: 1px solid #f0ede6;
  cursor: pointer;
}
.recent-avatar {
  width: 36px;
  height: 36px;
  border-radius: 50%;
  background: #ece3f1;
  color: var(--purple);
  font-weight: 700;
  font-size: 12px;
  display: grid;
  place-items: center;
}

/* ================= CONFIRM MODAL ================= */
.modal-backdrop {
  position: absolute;
  inset: 0;
  background: rgba(0,0,0,0.5);
  z-index: 100;
  display: none;
  justify-content: flex-end;
  flex-direction: column;
}
.modal-backdrop.show { display: flex; }
.bottom-modal {
  background: #fff;
  border-radius: 26px 26px 0 0;
  padding: 22px 20px 26px;
  animation: slideUp .2s ease-out;
}
@keyframes slideUp {
  from { transform: translateY(100%); }
  to { transform: translateY(0); }
}
.modal-pill-handle {
